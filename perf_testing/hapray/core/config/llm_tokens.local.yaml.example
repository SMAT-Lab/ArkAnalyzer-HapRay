# Deprecated: LLM Token / 凭据本地配置模板
#
# root-cause 现在与 tools/symbol_recovery 保持一致，推荐使用 .env / 环境变量：
#   LLM_SERVICE_TYPE=poe
#   LLM_API_KEY=your_api_key_here
#   LLM_BASE_URL=https://api.poe.com/v1
#   LLM_MODEL=GPT-5
#
# 此 YAML 仅作为旧版 --llm-tokens <path> 兼容入口保留，不再自动发现。

llm:
  provider: openai                         # openai-compatible endpoint
  base_url: https://api.poe.com/v1
  api_key: "sk-..."
  model: GPT-5
  max_tokens: 4096

analysis:
  top_n_hotspots: 10    # 取 top N 空刷代表帧
  language: zh          # 报告语言：zh / en
